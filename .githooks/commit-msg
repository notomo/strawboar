#!/bin/sh
# Commit messages are in English like the rest of this public repository.
# Same characters as `has_japanese` in src/rules.
set -e
node -e '
const lines = require("fs").readFileSync(process.argv[1], "utf8").split("\n");
const end = lines.findIndex((line) => line.startsWith("# ------------------------ >8"));
const message = (end < 0 ? lines : lines.slice(0, end)).filter((line) => !line.startsWith("#"));
// CJK symbols, kana, kanji and full-width forms.
const ranges = [[0x3000, 0x30ff], [0x3400, 0x9fff], [0xff00, 0xffef]];
const isJapanese = (c) => ranges.some(([from, to]) => from <= c.codePointAt(0) && c.codePointAt(0) <= to);
const japanese = message.filter((line) => [...line].some(isJapanese));
if (japanese.length > 0) {
  console.error("Write the commit message in English:\n" + japanese.join("\n"));
  process.exit(1);
}
' "$1"
